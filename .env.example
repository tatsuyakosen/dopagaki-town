# All values are optional. Local play works with the defaults embedded in the app.
# Match Server overrides
PORT=3001
STANDARD_MATCH_SEED=20260831
STANDARD_MATCH_DURATION_MS=600000
DEMO_MATCH_SEED=20260827
DEMO_MATCH_DURATION_MS=180000
PATCH_INTERVAL_MS=20000

# Backward-compatible aliases for STANDARD_MATCH_*:
# MATCH_SEED=20260831
# MATCH_DURATION_MS=600000

# Test/diagnostic acceleration only. Keep 1 for normal play.
# HUMAN_SPEED_MULTIPLIER=1

# Optional M8 Director service boundary. The default "fixture" never calls an external service.
# DIRECTOR_ADAPTER=http
# DIRECTOR_URL=http://127.0.0.1:8080
# DIRECTOR_TIMEOUT_MS=8000
# DIRECTOR_AUTH=none
# Cloud Run private service only: DIRECTOR_AUTH=google-id-token
# DIRECTOR_AUDIENCE=https://director-service.example.run.app

# Director API process. Gemini ADK mode requires Node.js 24.13+ and Google credentials.
# DIRECTOR_PROVIDER=gemini-adk
# DIRECTOR_MODEL=gemini-flash-latest
# GEMINI_API_KEY=replace-with-a-secret-outside-version-control
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=replace-with-project-id
# GOOGLE_CLOUD_LOCATION=asia-northeast1

# Set only when the client and Match Server use different public origins.
# VITE_MATCH_WS_URL=ws://127.0.0.1:3001/ws

# Development-only Match Server port override. The default is 3001 on every Vite port.
# VITE_MATCH_PORT=3001

# LOW preset internal resolution scale. 1 is native resolution; higher is faster.
VITE_RENDER_SCALE=2.25
