FROM node:22.21.1-bookworm-slim AS build

WORKDIR /app
COPY . .
RUN npm ci --ignore-scripts --include-workspace-root \
  --workspace=@dopagaki/game-client \
  --workspace=@dopagaki/match-server
RUN npm run build:client
RUN ./node_modules/.bin/esbuild apps/match-server/src/index.ts \
  --bundle \
  --platform=node \
  --format=esm \
  --target=node22 \
  --sourcemap \
  --external:google-auth-library \
  --external:ws \
  --outfile=dist/match-server.mjs

FROM node:22.21.1-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV PORT=8080
ENV NODE_OPTIONS=--enable-source-maps
WORKDIR /app
COPY . .
RUN npm ci --ignore-scripts --omit=dev --omit=optional --workspace=@dopagaki/match-server
COPY --from=build /app/apps/game-client/dist ./apps/game-client/dist
COPY --from=build /app/dist/match-server.mjs ./dist/match-server.mjs
COPY --from=build /app/dist/match-server.mjs.map ./dist/match-server.mjs.map

USER node
EXPOSE 8080
CMD ["node", "dist/match-server.mjs"]
