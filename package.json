{
  "name": "dopagaki-town",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.0.0 || >=24.13.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch apps/match-server/src/index.ts",
    "dev:client": "vite --config apps/game-client/vite.config.ts",
    "dev:director": "tsx watch apps/director-api/src/index.ts",
    "build": "npm run build:client",
    "build:client": "vite build --config apps/game-client/vite.config.ts",
    "start": "tsx apps/match-server/src/index.ts",
    "start:director": "tsx apps/director-api/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:faults": "vitest run -t \"T-(0[1-9]|10)\"",
    "test:watch": "vitest",
    "test:headless": "vitest run packages/game-core/test/headless.test.ts",
    "test:e2e": "playwright test",
    "check:publish": "node --import tsx scripts/repository-safety.ts",
    "check:city-bundle": "node --import tsx scripts/check-city-bundle.ts",
    "verify:city-walk": "node --import tsx scripts/verify-city-walk.ts",
    "preview:client": "vite preview --config apps/game-client/vite.config.ts --host 127.0.0.1",
    "test:city-converter": "python3 -m unittest discover -s tests/city -p 'test_*.py'",
    "test:soak:m6": "playwright test --config playwright.soak.config.ts",
    "test:soak": "tsx scripts/run-m7-soak.ts",
    "test:soak:smoke": "tsx scripts/run-m7-soak.ts --matches=2 --duration-ms=30000 --sample-ms=1000 --progress-ms=10000",
    "verify:local": "npm run lint && npm run typecheck && npm run test:faults && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
