{
  "name": "dopagaki-town",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch apps/match-server/src/index.ts",
    "dev:client": "vite --config apps/game-client/vite.config.ts",
    "build": "npm run build:client",
    "build:client": "vite build --config apps/game-client/vite.config.ts",
    "start": "tsx apps/match-server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:headless": "vitest run packages/game-core/test/headless.test.ts",
    "test:e2e": "playwright test",
    "test:soak:m6": "playwright test --config playwright.soak.config.ts",
    "verify:local": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
